{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/i/:codice", "destination": "/invito" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
